<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_transport" model="ir.module.category">
        <field name="name">Transport</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_transport">
        <field name="name">Transport</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_transport"/>
        <field name="placeholder">Aucun rôle</field>
    </record>

    <record id="group_transport_dispatcher" model="res.groups">
        <field name="name">Dispatch</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_transport"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Planifie les départs, affecte le bus et le chauffeur, et tient les réservations.</field>
    </record>

    <record id="group_transport_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_transport"/>
        <field name="implied_ids" eval="[(4, ref('group_transport_dispatcher'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure les lignes, les arrêts et les horaires.</field>
    </record>
</odoo>
