<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_schedule_list" model="ir.ui.view">
        <field name="name">transport.schedule.list</field>
        <field name="model">transport.schedule</field>
        <field name="arch" type="xml">
            <list string="Horaires">
                <field name="name"/>
                <field name="line_id"/>
                <field name="time_departure" widget="float_time"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_transport_schedule_form" model="ir.ui.view">
        <field name="name">transport.schedule.form</field>
        <field name="model">transport.schedule</field>
        <field name="arch" type="xml">
            <form string="Horaire">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="line_id"/>
                            <field name="time_departure" widget="float_time"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Jours">
                        <group>
                            <field name="mon"/>
                            <field name="tue"/>
                            <field name="wed"/>
                            <field name="thu"/>
                        </group>
                        <group>
                            <field name="fri"/>
                            <field name="sat"/>
                            <field name="sun"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_schedule" model="ir.actions.act_window">
        <field name="name">Horaires</field>
        <field name="res_model">transport.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
