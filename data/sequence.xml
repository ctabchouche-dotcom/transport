<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_transport_departure" model="ir.sequence">
            <field name="name">Départ transport</field>
            <field name="code">transport.departure</field>
            <field name="prefix">DEP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_transport_booking" model="ir.sequence">
            <field name="name">Réservation transport</field>
            <field name="code">transport.booking</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_transport_contract" model="ir.sequence">
            <field name="name">Contrat transport</field>
            <field name="code">transport.contract</field>
            <field name="prefix">CTR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_transport_waitlist" model="ir.sequence">
            <field name="name">Liste d'attente transport</field>
            <field name="code">transport.waitlist</field>
            <field name="prefix">ATT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="param_transport_hold_minutes" model="ir.config_parameter">
            <field name="key">transport.hold_minutes</field>
            <field name="value">15</field>
        </record>

        <record id="ir_cron_transport_expire_holds" model="ir.cron">
            <field name="name">Transport : libérer les réservations expirées</field>
            <field name="model_id" ref="model_transport_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_holds()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
