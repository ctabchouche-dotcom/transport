<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_departure_generate_form" model="ir.ui.view">
        <field name="name">transport.departure.generate.form</field>
        <field name="model">transport.departure.generate</field>
        <field name="arch" type="xml">
            <form string="Générer les départs">
                <group>
                    <field name="line_id" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transport_departure_generate" model="ir.actions.act_window">
        <field name="name">Générer les départs</field>
        <field name="res_model">transport.departure.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
